QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 25px;
    background: #171C24;
    border: 0;
    border-left: 1px solid #303A48;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: @CONTROL_RADIUS@;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-top: 1px solid #303A48;
    border-bottom-right-radius: @CONTROL_RADIUS@;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #252D39;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: #303C4D;
}
QSpinBox::up-button:disabled, QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled, QDoubleSpinBox::down-button:disabled {
    background: #171B21;
    border-left-color: #29313C;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("@CHEVRON_UP_ICON@");
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("@CHEVRON_DOWN_ICON@");
    width: 12px;
    height: 12px;
}

QProgressBar { background: #252a33; border: 0; border-radius: 4px; text-align: center; min-height: 8px; }
QProgressBar::chunk { background: @ACCENT@; border-radius: 4px; }
QProgressBar:disabled { color: #687486; background: #1B2028; }
QProgressBar::chunk:disabled { background: #46566A; }

QSlider::groove:horizontal {
    height: 4px;
    background: #2B3340;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #52677F; border-radius: 2px; }
QSlider::add-page:horizontal { background: #2B3340; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background: #8AA6CD;
    border: 1px solid #A9BEDC;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: #A4BBDA; border-color: #C4D2E5; }
QSlider::handle:horizontal:focus { background: #A4BBDA; border-color: #D0DCEB; }
QSlider::handle:horizontal:pressed { background: #C1D1E7; border-color: #E1E8F2; }
QSlider::groove:horizontal:disabled,
QSlider::add-page:horizontal:disabled { background: #222831; }
QSlider::sub-page:horizontal:disabled { background: #394452; }
QSlider::handle:horizontal:disabled { background: #46515F; border-color: #566270; }
QSlider::groove:vertical {
    width: 4px;
    background: #2B3340;
    border-radius: 2px;
}
QSlider::sub-page:vertical { background: #2B3340; border-radius: 2px; }
QSlider::add-page:vertical { background: #52677F; border-radius: 2px; }
QSlider::handle:vertical {
    height: 14px;
    margin: 0 -5px;
    background: #8AA6CD;
    border: 1px solid #A9BEDC;
    border-radius: 7px;
}
QSlider::handle:vertical:hover,
QSlider::handle:vertical:focus { background: #A4BBDA; border-color: #C4D2E5; }
QSlider::handle:vertical:pressed { background: #C1D1E7; border-color: #E1E8F2; }
QSlider::groove:vertical:disabled,
QSlider::sub-page:vertical:disabled { background: #222831; }
QSlider::add-page:vertical:disabled { background: #394452; }
QSlider::handle:vertical:disabled { background: #46515F; border-color: #566270; }

QLabel#ModernUiHint { color: #8f99a8; font-size: 9pt; background: transparent; }

/* IDA's text-based analysis views and common plugin consoles. */
QPlainTextEdit, QTextEdit {
    font-family: "@CODE_FONT@";
}

/* Adaptive Qt plugin panels.  The runtime sets the root property only on a
   compatible dock-content root (or an explicitly registered widget).  Every
   control rule also requires a semantic role, keeping this layer away from
   custom-painted viewers and leaving plugin-owned geometry untouched. */
QWidget[modernUiPluginPanel="adaptive"] {
    background: #14171D;
    color: #D7DEE8;
}
QToolBar[modernUiPluginPanel="adaptive"][modernUiPanelRole="toolbar"],
QWidget[modernUiPluginPanel="adaptive"] QToolBar[modernUiPanelRole="toolbar"] {
    background: #181E27;
    border: 0;
    border-bottom: 1px solid #2D3744;
    border-radius: @RADIUS@;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"],
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"] {
    background: #0F141B;
    color: #D7DEE8;
    border-color: #354253;
    border-radius: @RADIUS@;
    selection-background-color: @ACCENT@;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"]:focus,
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"]:focus {
    background: #101722;
    border-color: @ACCENT@;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"]:hover,
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"]:hover {
    border-color: #46566A;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"]:read-only,
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"]:read-only {
    background: #151920;
    color: #AAB4C3;
    border-color: #303844;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"]:read-only:focus,
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"]:read-only:focus {
    background: #151B23;
    border-color: #52677F;
}
QLineEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="search"]:disabled,
QWidget[modernUiPluginPanel="adaptive"] QLineEdit[modernUiPanelRole="search"]:disabled {
    background: #151920;
    color: #687486;
    border-color: #29313C;
}
QTreeView[modernUiPluginPanel="adaptive"][modernUiPanelRole="tree"],
QTableView[modernUiPluginPanel="adaptive"][modernUiPanelRole="table"],
QListView[modernUiPluginPanel="adaptive"][modernUiPanelRole="list"],
QWidget[modernUiPluginPanel="adaptive"] QTreeView[modernUiPanelRole="tree"],
QWidget[modernUiPluginPanel="adaptive"] QTableView[modernUiPanelRole="table"],
QWidget[modernUiPluginPanel="adaptive"] QListView[modernUiPanelRole="list"] {
    background: #0F141B;
    alternate-background-color: #131922;
    color: #D5DCE6;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    outline: 0;
    gridline-color: #27313E;
    selection-background-color: #31405A;
    selection-color: #F0F4FA;
}
QTreeView[modernUiPluginPanel="adaptive"][modernUiPanelRole="tree"] > QWidget#qt_scrollarea_viewport,
QTableView[modernUiPluginPanel="adaptive"][modernUiPanelRole="table"] > QWidget#qt_scrollarea_viewport,
QListView[modernUiPluginPanel="adaptive"][modernUiPanelRole="list"] > QWidget#qt_scrollarea_viewport,
QWidget[modernUiPluginPanel="adaptive"] QTreeView[modernUiPanelRole="tree"] > QWidget#qt_scrollarea_viewport,
QWidget[modernUiPluginPanel="adaptive"] QTableView[modernUiPanelRole="table"] > QWidget#qt_scrollarea_viewport,
QWidget[modernUiPluginPanel="adaptive"] QListView[modernUiPanelRole="list"] > QWidget#qt_scrollarea_viewport {
    background: #0F141B;
    border: 0;
    border-radius: @PANEL_INNER_RADIUS@;
}
QHeaderView[modernUiPluginPanel="adaptive"][modernUiPanelRole="header"],
QWidget[modernUiPluginPanel="adaptive"] QHeaderView[modernUiPanelRole="header"] {
    background: transparent;
    border: 0;
}
QHeaderView[modernUiPluginPanel="adaptive"][modernUiPanelRole="header"]::section,
QWidget[modernUiPluginPanel="adaptive"] QHeaderView[modernUiPanelRole="header"]::section {
    background: #1B232D;
    color: #C1CBD8;
    border: 0;
    border-right: 1px solid #2C3744;
    border-bottom: 1px solid #354253;
}
QHeaderView[modernUiPluginPanel="adaptive"][modernUiPanelRole="header"]::section:hover,
QWidget[modernUiPluginPanel="adaptive"] QHeaderView[modernUiPanelRole="header"]::section:hover {
    background: #252D38;
    color: #D8E0EA;
}
QHeaderView[modernUiPluginPanel="adaptive"][modernUiPanelRole="header"]::section:pressed,
QWidget[modernUiPluginPanel="adaptive"] QHeaderView[modernUiPanelRole="header"]::section:pressed {
    background: #2C3745;
    color: #EEF3FA;
}
QHeaderView[modernUiPluginPanel="adaptive"][modernUiPanelRole="header"]::section:disabled,
QWidget[modernUiPluginPanel="adaptive"] QHeaderView[modernUiPanelRole="header"]::section:disabled {
    background: #1A2028;
    color: #687486;
}
QTreeView[modernUiPluginPanel="adaptive"][modernUiPanelRole="tree"]::item:hover,
QTableView[modernUiPluginPanel="adaptive"][modernUiPanelRole="table"]::item:hover,
QListView[modernUiPluginPanel="adaptive"][modernUiPanelRole="list"]::item:hover,
QWidget[modernUiPluginPanel="adaptive"] QTreeView[modernUiPanelRole="tree"]::item:hover,
QWidget[modernUiPluginPanel="adaptive"] QTableView[modernUiPanelRole="table"]::item:hover,
QWidget[modernUiPluginPanel="adaptive"] QListView[modernUiPanelRole="list"]::item:hover {
    background: #1B2430;
}
QTreeView[modernUiPluginPanel="adaptive"][modernUiPanelRole="tree"]::item:selected,
QTableView[modernUiPluginPanel="adaptive"][modernUiPanelRole="table"]::item:selected,
QListView[modernUiPluginPanel="adaptive"][modernUiPanelRole="list"]::item:selected,
QWidget[modernUiPluginPanel="adaptive"] QTreeView[modernUiPanelRole="tree"]::item:selected,
QWidget[modernUiPluginPanel="adaptive"] QTableView[modernUiPanelRole="table"]::item:selected,
QWidget[modernUiPluginPanel="adaptive"] QListView[modernUiPanelRole="list"]::item:selected {
    background: #31405A;
    color: #F0F4FA;
}
QTreeView[modernUiPluginPanel="adaptive"][modernUiPanelRole="tree"]::item:selected:!active,
QTableView[modernUiPluginPanel="adaptive"][modernUiPanelRole="table"]::item:selected:!active,
QListView[modernUiPluginPanel="adaptive"][modernUiPanelRole="list"]::item:selected:!active,
QWidget[modernUiPluginPanel="adaptive"] QTreeView[modernUiPanelRole="tree"]::item:selected:!active,
QWidget[modernUiPluginPanel="adaptive"] QTableView[modernUiPanelRole="table"]::item:selected:!active,
QWidget[modernUiPluginPanel="adaptive"] QListView[modernUiPanelRole="list"]::item:selected:!active {
    background: #29364A;
    color: #D8E0EA;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"],
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"],
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"],
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"] {
    background: #0F141B;
    color: #CBD4E0;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    selection-background-color: #34415B;
    selection-color: #F1F5FA;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:hover,
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:hover,
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"]:hover,
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"]:hover {
    border-color: #46566A;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:focus,
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:focus,
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"]:focus,
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"]:focus {
    border-color: #50627A;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:read-only,
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:read-only,
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"]:read-only,
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"]:read-only {
    background: #121820;
    color: #AAB4C3;
    border-color: #303844;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:read-only:focus,
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:read-only:focus,
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"]:read-only:focus,
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"]:read-only:focus {
    background: #131A23;
    border-color: #50627A;
}
QPlainTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:disabled,
QTextEdit[modernUiPluginPanel="adaptive"][modernUiPanelRole="console"]:disabled,
QWidget[modernUiPluginPanel="adaptive"] QPlainTextEdit[modernUiPanelRole="console"]:disabled,
QWidget[modernUiPluginPanel="adaptive"] QTextEdit[modernUiPanelRole="console"]:disabled {
    background: #151920;
    color: #687486;
    border-color: #29313C;
}
QFrame[modernUiPluginPanel="adaptive"][modernUiPanelRole="surface"],
QWidget[modernUiPluginPanel="adaptive"] QFrame[modernUiPanelRole="surface"] {
    background: #0F141B;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
}
QLabel[modernUiPluginPanel="adaptive"][modernUiPanelRole="empty"],
QWidget[modernUiPluginPanel="adaptive"] QLabel[modernUiPanelRole="empty"] {
    background: transparent;
    color: #7F8B9D;
}
QLabel[modernUiPluginPanel="adaptive"][modernUiPanelRole="badge"],
QWidget[modernUiPluginPanel="adaptive"] QLabel[modernUiPanelRole="badge"] {
    background: #273448;
    color: #CFE0FA;
    border: 1px solid #3B4C64;
    border-radius: @CONTROL_RADIUS@;
}
QLabel[modernUiPluginPanel="adaptive"][modernUiPanelRole="muted"],
QWidget[modernUiPluginPanel="adaptive"] QLabel[modernUiPanelRole="muted"] {
    background: transparent;
    color: #8794A6;
}

/* IDA-specific analysis widgets. These selectors are intentionally scoped. */
/*
 * IDA's command line is wrapped in an untitled QGroupBox.  The generic
 * titled-card rule above otherwise contributes 10px of title margin plus
 * 12px of top padding, which becomes a conspicuous empty strip on HiDPI
 * displays.  Keep the override on the exact ConsoleWidget child path so
 * ordinary dialogs and third-party plugin group boxes retain card spacing.
 */
ConsoleWidget > CLIWidget > QGroupBox {
    border: 0;
    margin: 0;
    padding: 4px 8px;
    font-weight: 400;
    background: transparent;
}
ConsoleWidget > CLIWidget > QGroupBox::title {
    height: 0;
    margin: 0;
    padding: 0;
}
ConsoleWidget > CLIWidget QLineEdit {
    /* Give the command surface one quiet elevation above the log card while
       keeping the native line-edit geometry untouched. */
    background: #111822;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    padding: @CONTROL_V@ 9px;
}
ConsoleWidget > CLIWidget QLineEdit:focus {
    background: #101722;
    border-color: #50627A;
}
ConsoleWidget > CLIWidget QPushButton {
    background: #222B38;
    color: #CBD7E8;
    border: 1px solid #3A4759;
    border-radius: @PANEL_RADIUS@;
}
ConsoleWidget > CLIWidget QPushButton:hover {
    background: #293546;
    border-color: #50627A;
}
ConsoleWidget > CLIWidget QPushButton:focus {
    border-color: #50627A;
}

/*
 * The IDA 9.3 Functions dirtree exposes a visible but intentionally empty
 * QHeaderView.  Generic header padding expands it to roughly 45-50 physical
 * pixels at common Windows scaling.  Only collapse that private IDA view;
 * chooser tables and plugin-owned trees keep their normal column headers.
 */
functions_dirtree_widget_t > QHeaderView {
    min-height: 0;
    max-height: 0;
    border: 0;
}
functions_dirtree_widget_t > QHeaderView::section {
    min-height: 0;
    max-height: 0;
    padding: 0;
    border: 0;
}

/* Functions uses row selection across several model columns.  Keep every
   selected cell square so the native fill remains one continuous strip.  A
   local post-paint runtime rounds only the visual beginning/end of each row;
   this avoids the disconnected first-cell capsule seen in the old QSS rules. */
functions_dirtree_widget_t {
    /* Include the decoration/icon column in the same selected strip.  With
       this enabled the post-paint mask can round one continuous row instead
       of leaving a darker first-cell block beside the function icon. */
    show-decoration-selected: 1;
    /* IDA's private dirtree paints the decoration strip from these
       properties instead of QTreeView's standard item brush.  Match the
       selected/default cells so the icon gutter joins the text cell without
       a dark seam. */
    qproperty-highlight-bg-default: #0F141B;
    qproperty-highlight-bg-selected: #31405A;
}
functions_dirtree_widget_t::item:selected {
    background: #31405A;
    color: #F0F4FA;
    border-radius: 0;
}

log_widget_t, log_widget_t[os-dark-theme="true"] {
    background: #101319;
    color: #C8D0DC;
    font-family: "@CODE_FONT@";
    font-size: 10pt;
    border: 1px solid #303846;
    border-radius: @RADIUS@;
    margin: 6px 8px 4px 8px;
    padding: 6px 8px;
    selection-background-color: #34415B;
    selection-color: #F1F5FA;
}
log_widget_t:focus, log_widget_t[os-dark-theme="true"]:focus {
    border-color: #46546A;
}
/* The built-in Output panel receives a slightly deeper, more spacious card.
   The parent-qualified selector leaves third-party log widgets unchanged. */
ConsoleWidget > log_widget_t,
ConsoleWidget > log_widget_t[os-dark-theme="true"] {
    background: #0F141B;
    color: #CCD4DF;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    margin: 7px 10px 5px 10px;
    padding: 7px 9px;
    selection-background-color: #34415B;
    selection-color: #F1F5FA;
}
ConsoleWidget > log_widget_t:focus,
ConsoleWidget > log_widget_t[os-dark-theme="true"]:focus {
    border-color: #50627A;
}
log_widget_t QWidget, log_widget_t[os-dark-theme="true"] QWidget {
    background: transparent;
    border: 0;
}
log_widget_t QScrollBar:vertical,
log_widget_t[os-dark-theme="true"] QScrollBar:vertical {
    width: 8px;
    margin: 2px 1px;
}
log_widget_t QScrollBar:horizontal,
log_widget_t[os-dark-theme="true"] QScrollBar:horizontal {
    height: 8px;
    margin: 1px 2px;
}
log_widget_t QScrollBar::handle:vertical,
log_widget_t QScrollBar::handle:horizontal,
log_widget_t[os-dark-theme="true"] QScrollBar::handle:vertical,
log_widget_t[os-dark-theme="true"] QScrollBar::handle:horizontal {
    background-color: #394351;
    border: 0;
    border-radius: 5px;
    margin: 1px;
}
log_widget_t QScrollBar::handle:vertical:hover,
log_widget_t QScrollBar::handle:horizontal:hover,
log_widget_t[os-dark-theme="true"] QScrollBar::handle:vertical:hover,
