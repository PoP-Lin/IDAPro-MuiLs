TChooser#Strings tchooser_table_widget_t#Strings QScrollBar::handle:vertical:hover,
TChooser#Strings tchooser_table_widget_t#Strings QScrollBar::handle:horizontal:hover,
chooser_widget_t#Strings chooser_table_widget_t#Strings QScrollBar::handle:vertical:hover,
chooser_widget_t#Strings chooser_table_widget_t#Strings QScrollBar::handle:horizontal:hover,
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t QScrollBar::handle:vertical:hover,
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t QScrollBar::handle:horizontal:hover {
