TChooser#Strings tchooser_table_widget_t#Strings QScrollBar::handle:vertical:pressed,
TChooser#Strings tchooser_table_widget_t#Strings QScrollBar::handle:horizontal:pressed,
chooser_widget_t#Strings chooser_table_widget_t#Strings QScrollBar::handle:vertical:pressed,
chooser_widget_t#Strings chooser_table_widget_t#Strings QScrollBar::handle:horizontal:pressed,
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t QScrollBar::handle:vertical:pressed,
