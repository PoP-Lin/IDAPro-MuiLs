/* Restrained Material-inspired theme. Generic selectors keep plugin panels compatible. */
QWidget {
    background-color: #17191f;
    color: #d8dee9;
    font-family: "@FONT_FAMILY@";
    font-size: @FONT_SIZE@;
    selection-background-color: @ACCENT@;
    selection-color: #101218;
}
QLabel { background: transparent; }

QMainWindow, QDialog { background-color: #17191f; }
IDAMainWindow { background-color: #17191f; }

QDockWidget {
    background: #171A20;
    color: #CBD3DF;
    border: 0;
}
QDockWidget::title {
    background: #1C2028;
    border: 0;
    border-bottom: 1px solid #303744;
    border-top-left-radius: @SMALL_RADIUS@;
    border-top-right-radius: @SMALL_RADIUS@;
    padding: 5px 8px;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: 0;
    border-radius: @SMALL_RADIUS@;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #343B49;
}
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    background: #202731;
}
DockWidgetTitle, DockAreaDragTitle {
    background: #1C222B;
    color: #CDD5E0;
    border: 0;
    border-bottom: 1px solid #2D3744;
    margin: 0;
    /* The native title layout already owns vertical margins around its 26px
       controls. Extra QSS padding made Output/Strings headers 41px tall. */
    padding: 0 9px;
}
/* Keep dock cards visibly rounded without the wide gutters of a full card margin. */
DockWidgetTitle {
    border-top-left-radius: @PANEL_RADIUS@;
    border-top-right-radius: @PANEL_RADIUS@;
}
/* The dedicated floating drag title can carry the visible window rounding. */
DockAreaDragTitle {
    border-top-left-radius: @PANEL_RADIUS@;
    border-top-right-radius: @PANEL_RADIUS@;
}
DockWidgetTitle[active="true"] {
    background: #222A35;
    border-bottom-color: #4A596E;
}
DockWidgetTitle QWidget, DockAreaDragTitle QWidget {
    background: transparent;
    border: 0;
}
DockWidgetTitle > QPushButton, DockAreaDragTitle > QPushButton {
    background: transparent;
    border: 0;
    border-radius: @SMALL_RADIUS@;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    margin: 0;
    padding: 1px;
}
DockWidgetTitle > QPushButton:hover, DockAreaDragTitle > QPushButton:hover {
    background: #343b49;
}
DockWidgetTitle > QPushButton:focus, DockAreaDragTitle > QPushButton:focus {
    background: #293341;
    border: 1px solid #52677F;
}
DockWidgetTitle > QPushButton:pressed, DockAreaDragTitle > QPushButton:pressed {
    background: #202731;
}
DockWidgetTitle > QPushButton:disabled, DockAreaDragTitle > QPushButton:disabled {
    background: transparent;
    border: 0;
}

QMenuBar { background: #1B1E25; spacing: 1px; border-bottom: 1px solid #272C35; }
QMenuBar::item { background: transparent; padding: 3px 8px; border-radius: @CONTROL_RADIUS@; }
QMenuBar::item:selected { background: #2a2f3a; }
QMenuBar::item:pressed, QMenuBar::item:open { background: #303747; color: #EEF3FA; }
QMenuBar::item:disabled { color: #687486; background: transparent; }
QMenu {
    background: #20242c;
    border: 1px solid #343a46;
    border-radius: @SMALL_RADIUS@;
    padding: 5px;
}
QMenu::item { padding: @CONTROL_V@ 26px @CONTROL_V@ @CONTROL_H@; border-radius: @SMALL_RADIUS@; }
QMenu::item:selected { background: #303747; color: #eef3ff; }
QMenu::item:disabled { color: #687486; background: transparent; }
QMenu::item:checked { background: #293342; color: #EEF3FA; }
QMenu::item:checked:selected { background: #344258; }
QMenu::item:checked:disabled { background: #222833; color: #687486; }
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 5px;
    border: 1px solid transparent;
    border-radius: 3px;
}
QMenu::indicator:checked {
    image: url("@CHECK_ON_ICON@");
    background: @ACCENT@;
    border-color: @ACCENT@;
}
QMenu::indicator:checked:disabled {
    image: url("@CHECK_ON_ICON@");
    background: #46515F;
    border-color: #566270;
}
QMenu::separator { height: 1px; background: #353b47; margin: 5px 8px; }

QToolBar {
    background: #181B21;
    border: 0;
    border-bottom: 1px solid #292E38;
    spacing: 1px;
    padding: 1px 3px;
    qproperty-iconSize: 18px 18px;
}
QToolBar::handle { image: none; width: 3px; background: transparent; }
QToolBar::separator { background: #303641; width: 1px; margin: 5px 5px; }
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @CONTROL_RADIUS@;
    min-width: 22px;
    min-height: 22px;
    padding: 2px;
    margin: 0;
}
QToolButton:hover { background: #2b303b; }
QToolButton:focus { background: #293341; border-color: #52677F; }
QToolButton:pressed, QToolButton:checked, QToolButton:open {
    background: #343b49;
    border-color: #46566A;
}
QToolButton:checked:focus, QToolButton:open:focus {
    background: #344258;
    border-color: #7890B1;
}
QToolButton:checked:pressed, QToolButton:open:pressed {
    background: #202731;
    border-color: #52677F;
}
QToolButton:disabled { background: transparent; border-color: transparent; color: #687486; }

QPushButton {
    background: #292f3a;
    border: 1px solid #3b4351;
    border-radius: @CONTROL_RADIUS@;
    padding: @CONTROL_V@ @CONTROL_H@;
}
QPushButton:hover { border-color: @ACCENT@; background: #303744; }
QPushButton:focus { border-color: #52677F; background: #2B3340; }
QPushButton:pressed { background: #222731; }
QPushButton:checked { background: #344258; border-color: #52677F; color: #F0F4FA; }
QPushButton:checked:focus { background: #344258; border-color: #7890B1; color: #F0F4FA; }
QPushButton:checked:pressed { background: #202731; border-color: #52677F; color: #F0F4FA; }
QPushButton:disabled { color: #686f7c; background: #20232a; border-color: #2a2e37; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #111319;
    border: 1px solid #353c48;
    border-radius: @RADIUS@;
    padding: @CONTROL_V@ @CONTROL_H@;
    placeholder-text-color: #7F8B9D;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #46566A;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    background: #111820;
    border-color: @ACCENT@;
}
QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only {
    background: #151920;
    color: #AAB4C3;
    border-color: #303844;
}
QLineEdit:read-only:hover, QTextEdit:read-only:hover, QPlainTextEdit:read-only:hover {
    border-color: #3E4958;
}
QLineEdit:read-only:focus, QTextEdit:read-only:focus, QPlainTextEdit:read-only:focus {
    background: #151B23;
    border-color: #52677F;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #151920;
    color: #687486;
    border-color: #29313C;
}

QTabWidget::pane { border: 1px solid #292F3A; border-radius: @CONTROL_RADIUS@; top: -1px; }
QTabBar { background: #171A20; border: 0; }
QTabBar::tab {
    background: #1B1F27;
    color: #8E98A8;
    padding: 4px 8px;
    margin-right: 1px;
    border: 0;
    border-top: 2px solid transparent;
    border-bottom: 1px solid #292F3A;
    border-top-left-radius: @CONTROL_RADIUS@;
    border-top-right-radius: @CONTROL_RADIUS@;
}
QTabBar::tab:hover { background: #222833; color: #CFD7E3; }
QTabBar::tab:selected {
    color: #EEF3FA;
    border-top-color: @ACCENT@;
    border-bottom-color: #242A34;
    background: #242A34;
}
QTabBar::tab:pressed { background: #1E2530; color: #E1E7F0; }
QTabBar::tab:disabled { background: #191D24; color: #606B7A; }
QTabBar::tab:selected:disabled {
    background: #20252D;
    color: #707B89;
    border-top-color: #46515F;
    border-bottom-color: #292F3A;
}
QTabBar QToolButton { background: #1B1F27; border-radius: @CONTROL_RADIUS@; padding: 2px; }
QTabBar QToolButton:hover { background: #2B3340; }
QTabBar QToolButton:focus { background: #293341; border-color: #52677F; }
QTabBar QToolButton:disabled { background: #191D24; border-color: transparent; }
QTabBar::close-button {
    image: url("@CLOSE_ICON@");
    width: 14px;
    height: 14px;
    margin: 1px 2px;
}
QTabBar::close-button:hover, QTabBar::close-button:selected:hover {
    image: url("@CLOSE_HOVER_ICON@");
    background: #2B3340;
    border-radius: @SMALL_RADIUS@;
}
QTabBar::close-button:pressed, QTabBar::close-button:selected:pressed {
    image: url("@CLOSE_HOVER_ICON@");
    background: #1E2530;
    border-radius: @SMALL_RADIUS@;
}

QTreeView, QTableView, QListView {
    background: #14161c;
    alternate-background-color: #181b22;
    border: 1px solid #252B35;
    outline: 0;
    gridline-color: #272c35;
}
QTreeView::item, QTableView::item, QListView::item { padding: @ITEM@; }
QTreeView::item:hover, QTableView::item:hover, QListView::item:hover { background: #1B2430; }
QTreeView::item:selected, QTableView::item:selected, QListView::item:selected { background: #35405a; color: #edf3ff; }
QTreeView::item:selected:!active, QTableView::item:selected:!active,
QListView::item:selected:!active { background: #2D3749; color: #D8E0EA; }
QTreeView::item:disabled, QTableView::item:disabled, QListView::item:disabled { color: #687486; }
QTreeView::branch { background: transparent; }
QTreeView::branch:closed:has-children { image: url("@CHEVRON_RIGHT_ICON@"); }
QTreeView::branch:open:has-children { image: url("@CHEVRON_DOWN_ICON@"); }
QHeaderView::section {
    background: #1E232C;
    color: #B8C1CE;
    border: 0;
    border-right: 1px solid #2C333E;
    border-bottom: 1px solid #2C333E;
    padding: 4px 7px;
}
QHeaderView::section:hover { background: #252C37; color: #D7DEE8; }
QHeaderView::section:pressed { background: #2B3543; }
QHeaderView::section:disabled { color: #687486; background: #1B2028; }
QTableCornerButton::section {
    background: #1E232C;
    border: 0;
    border-right: 1px solid #2C333E;
    border-bottom: 1px solid #2C333E;
    border-top-left-radius: @CONTROL_RADIUS@;
}
QTableCornerButton::section:hover { background: #252C37; }
QTableCornerButton::section:pressed { background: #2B3543; }
QTableCornerButton::section:disabled { background: #1B2028; }
QHeaderView::up-arrow {
    image: url("@CHEVRON_UP_ICON@");
    width: 12px;
    height: 12px;
}
QHeaderView::down-arrow {
    image: url("@CHEVRON_DOWN_ICON@");
    width: 12px;
    height: 12px;
}

/* Keep native scrollbar geometry and plugin-panel hit targets unchanged.
   IDA-owned views receive the antialiased rounded visual layer from
   scrollbar_runtime.py; ordinary Qt/plugin scrollbars retain this lightweight
   fallback style. */
QScrollBar:vertical { background: transparent; width: 9px; margin: 1px; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 1px; }
QScrollBar::handle { background: #3D4553; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #596273; }
QScrollBar::handle:pressed { background: #60708A; }
QScrollBar::handle:disabled { background: #2B333F; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip { background: #252a33; color: #eef2f7; border: 1px solid #434b59; border-radius: @CONTROL_RADIUS@; padding: 5px; }
QStatusBar { background: #181B21; border-top: 1px solid #292E38; min-height: 22px; padding: 0 5px; }
QStatusBar::item { border: 0; }
/* Keep a generous resize hit target while painting only a restrained 1px seam. */
QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal {
    border-left: 1px solid #2D3440;
    margin: 0 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #2D3440;
    margin: 3px 0;
}
QSplitter::handle:horizontal:hover { border-left-color: #53627A; }
QSplitter::handle:vertical:hover { border-top-color: #53627A; }
QSplitter::handle:horizontal:pressed { border-left-color: #7890B1; }
QSplitter::handle:vertical:pressed { border-top-color: #7890B1; }
/* Reduce the dark gutter between the editor and the lower panel row without
   shrinking the native splitter's practical drag target. */
TopLevelDockArea QSplitter::handle:vertical {
    height: 6px;
    margin: 0;
    background: #17191F;
    border-top: 1px solid #2D3440;
}
TopLevelDockArea QSplitter::handle:vertical:hover {
    border-top-color: #53627A;
}
TopLevelDockArea QSplitter::handle:vertical:pressed {
    border-top-color: #7890B1;
}

QGroupBox {
    border: 1px solid #303641;
    border-radius: @RADIUS@;
    margin-top: 10px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 9px; padding: 0 5px; }

QCheckBox, QRadioButton { spacing: 7px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator { border: 1px solid #596273; border-radius: 4px; background: #111319; }
QCheckBox::indicator:hover { border-color: @ACCENT@; }
QCheckBox::indicator:focus { border-color: #7890B1; }
QCheckBox::indicator:pressed { background: #202A37; border-color: #7890B1; }
QCheckBox::indicator:checked {
    image: url("@CHECK_ON_ICON@");
    background: @ACCENT@;
    border-color: @ACCENT@;
}
QCheckBox::indicator:indeterminate {
    background: #52677F;
    border-color: #7890B1;
}
QCheckBox:disabled, QRadioButton:disabled { color: #687486; }
QCheckBox::indicator:disabled { background: #1B2028; border-color: #343C48; }
QCheckBox::indicator:checked:disabled { image: url("@CHECK_ON_ICON@"); background: #46566A; }
QCheckBox::indicator:indeterminate:disabled { background: #343E4B; border-color: #46515F; }
QCheckBox::indicator:checked:focus { border-color: #A9BEDC; }
QRadioButton::indicator {
    image: url("@RADIO_OFF_ICON@");
    width: 18px;
    height: 18px;
    border: 0;
    background: transparent;
}
QRadioButton::indicator:checked { image: url("@RADIO_ON_ICON@"); }
QRadioButton:focus { color: #F0F4FA; }
QRadioButton::indicator:hover, QRadioButton::indicator:focus { background: #202733; border-radius: 9px; }
QRadioButton::indicator:pressed { background: #293546; border-radius: 9px; }
QRadioButton::indicator:disabled { image: url("@RADIO_OFF_ICON@"); }
QRadioButton::indicator:checked:disabled { image: url("@RADIO_ON_DISABLED_ICON@"); }

QComboBox::drop-down {
    border: 0;
    border-top-right-radius: @CONTROL_RADIUS@;
    border-bottom-right-radius: @CONTROL_RADIUS@;
    width: 28px;
}
QComboBox:open { background: #141B24; border-color: #52677F; }
QComboBox::drop-down:hover { background: #222B36; }
QComboBox::drop-down:pressed, QComboBox::drop-down:open { background: #293546; }
QComboBox::drop-down:disabled { background: transparent; }
QComboBox::down-arrow {
    image: url("@CHEVRON_DOWN_ICON@");
    width: 14px;
    height: 14px;
}
QComboBox QAbstractItemView {
    background: #20242c;
    color: #D8DEE9;
    border: 1px solid #3b4351;
    border-radius: @SMALL_RADIUS@;
    outline: 0;
    selection-background-color: #35405a;
    selection-color: #F0F4FA;
}
QComboBox QAbstractItemView::item:hover { background: #293342; }
QComboBox QAbstractItemView::item:selected { background: #35405A; color: #F0F4FA; }
QComboBox QAbstractItemView::item:disabled { color: #687486; }

/* Composite editors own one outer frame.  Their private line edit remains a
   text/caret surface and must not inherit a second border or rounded inset. */
QComboBox > QLineEdit,
QSpinBox > QLineEdit,
QDoubleSpinBox > QLineEdit,
QComboBox > QLineEdit:focus,
QSpinBox > QLineEdit:focus,
QDoubleSpinBox > QLineEdit:focus {
    background: transparent;
    border: 0;
    border-radius: 0;
    margin: 0;
    min-height: 0;
    padding: 0;
}

/* IDA's compact form fields use an editable QComboBox whose input_field_t is
   already framed by the combo.  Reset that inner editor so it cannot inherit
   the generic QLineEdit frame/padding and clip the caret on HiDPI screens. */
ui_form_dialog_t QComboBox > input_field_t,
ui_form_dialog_t QComboBox > input_field_t:focus {
    background: transparent;
    border: 0;
    border-radius: 0;
    margin: 0;
    min-height: 0;
    padding: 0;
    selection-background-color: #31405A;
    selection-color: #F0F4FA;
}

/* G / Jump to address is a small IDA-owned search form.  Keep its address
   history affordance, but give the single outer field a quieter focus ring and
   a compact width.  The exact title scope avoids changing plugin dialogs or
   unrelated IDA forms. */
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > buddy_label_t {
    color: #CDD6E2;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox {
    background: #111820;
    color: #E0E6EF;
    border: 1px solid #3B4859;
    border-radius: @SMALL_RADIUS@;
    min-width: 213px;
    max-width: 213px;
    min-height: 28px;
    margin-left: 2px;
    padding: 0 28px 0 9px;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox:hover {
    border-color: #46566A;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox:focus {
    background: #111922;
    border-color: #52677F;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox:open {
    background: #141B24;
    border-color: #52677F;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox:disabled {
    background: #151920;
    color: #687486;
    border-color: #29313C;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox::drop-down {
    border: 0;
    border-top-right-radius: @SMALL_RADIUS@;
    border-bottom-right-radius: @SMALL_RADIUS@;
    width: 26px;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox::drop-down:hover {
    background: #222B36;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox::drop-down:pressed,
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox::drop-down:open {
    background: #293546;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox QAbstractItemView {
    background: #171D26;
    color: #DCE3EC;
    border: 1px solid #3B4859;
    border-radius: @SMALL_RADIUS@;
    outline: 0;
    padding: 3px;
    selection-background-color: #31405A;
    selection-color: #F0F4FA;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox QAbstractItemView::item:hover {
    background: #293342;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox QAbstractItemView::item:selected {
    background: #31405A;
    color: #F0F4FA;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QComboBox QAbstractItemView::item:disabled {
    color: #687486;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton {
    background: #252C36;
    border: 1px solid #394554;
    border-radius: @CONTROL_RADIUS@;
    min-width: 40px;
    min-height: 28px;
    padding: 0 10px;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:hover,
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:focus {
    background: #2B3541;
    border-color: #4A5A6C;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:pressed {
    background: #202731;
    border-color: #435064;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:disabled {
    background: #1B2027;
    border-color: #29313C;
    color: #687486;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default {
    background: #2C3B4E;
    border-color: #4D627C;
    color: #EDF3FA;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:hover,
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:focus {
    background: #34475D;
    border-color: #5B718C;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:pressed {
    background: #202B39;
    border-color: #52677F;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:hover:pressed,
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:focus:pressed {
    background: #1D2734;
    border-color: #5B718C;
}
ui_form_dialog_t[windowTitle="Jump to address"] > ida_form_widget_t > QDialogButtonBox > QPushButton:default:disabled {
    background: #1B2027;
    border-color: #29313C;
    color: #687486;
}

/* Alt+T / Text search uses the same single-field language as Jump while
   retaining its native option group.  Its unbounded history field otherwise
   stretches a small dialog to more than 500 logical pixels on HiDPI. */
ui_form_dialog_t[windowTitle="Text search (slow!)"] > ida_form_widget_t > buddy_label_t {
    color: #CDD6E2;
}
