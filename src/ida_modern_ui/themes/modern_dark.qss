CustomIDAMemo, viewer_t, chooser_widget_t, standalone_dirtree_widget_t, TChooser {
    background: #14161c;
    color: #D8DEE9;
    border: 0;
}
/* Output and Strings form a matched pair of independent inset cards. These
   selectors remain tied to the built-in #Strings object, so IDAPython Choose
   windows and third-party tables retain their own geometry and paint path. */
TChooser#Strings > QSplitter#Strings_splitter,
chooser_widget_t#Strings > QSplitter#Strings_splitter {
    background: transparent;
    border: 0;
}
TChooser#Strings > QSplitter#Strings_splitter > tchooser_table_widget_t#Strings,
chooser_widget_t#Strings > QSplitter#Strings_splitter > chooser_table_widget_t#Strings {
    background: #0F141B;
    color: #D7DEE8;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    margin: 7px 10px 4px 10px;
    padding: 3px;
}
TChooser#Strings > QSplitter#Strings_splitter > tchooser_table_widget_t#Strings:focus,
chooser_widget_t#Strings > QSplitter#Strings_splitter > chooser_table_widget_t#Strings:focus {
    border-color: #50627A;
}
TChooser#Strings tchooser_table_widget_t#Strings > QWidget#qt_scrollarea_viewport,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QWidget#qt_scrollarea_viewport {
    background: #0F141B;
    border: 0;
    /* Match the inset viewport to the card so the lower corners do not turn
       square when the native table repaints over the rounded frame. */
    border-radius: @PANEL_INNER_RADIUS@;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView {
    background: transparent;
    border: 0;
    border-top-left-radius: @PANEL_INNER_RADIUS@;
    border-top-right-radius: @PANEL_INNER_RADIUS@;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section {
    background: #1B232D;
    color: #C1CBD8;
    border: 0;
    border-right: 1px solid #293441;
    border-bottom: 1px solid #303B49;
    padding: 4px 8px;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:first,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:first {
    border-top-left-radius: @PANEL_INNER_RADIUS@;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:last,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:last {
    border-top-right-radius: @PANEL_INNER_RADIUS@;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:last,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:last {
    border-right: 0;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:hover,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:hover {
    background: #252D38;
    color: #D8E0EA;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:pressed,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:pressed {
    background: #2C3745;
    color: #EEF3FA;
}
TChooser#Strings tchooser_table_widget_t#Strings > QHeaderView::section:disabled,
chooser_widget_t#Strings chooser_table_widget_t#Strings > QHeaderView::section:disabled {
    background: #1A2028;
    color: #687486;
}
TChooser#Strings tchooser_table_widget_t#Strings::item,
chooser_widget_t#Strings chooser_table_widget_t#Strings::item {
    border: 0;
    padding: 3px 7px;
}
TChooser#Strings tchooser_table_widget_t#Strings::item:hover,
chooser_widget_t#Strings chooser_table_widget_t#Strings::item:hover {
    background: #1B2430;
}
TChooser#Strings tchooser_table_widget_t#Strings::item:selected,
chooser_widget_t#Strings chooser_table_widget_t#Strings::item:selected {
    background: #31405A;
    color: #F0F4FA;
}
TChooser#Strings tchooser_table_widget_t#Strings::item:selected:!active,
chooser_widget_t#Strings chooser_table_widget_t#Strings::item:selected:!active {
    background: #29364A;
    color: #D8E0EA;
}

/* Every IDA chooser's native quick filter is one search surface.  The private
   host classes include Names and plugin-created IDA choosers without matching
   arbitrary plugin QLineEdits.  Its clear button and input no longer draw two
   additional overlapping control frames. */
TChooser > quick_filter_widget_t,
chooser_widget_t > quick_filter_widget_t {
    background: #111822;
    border: 1px solid #354253;
    border-radius: @RADIUS@;
    margin: 0 10px 3px 10px;
}
TChooser > quick_filter_widget_t:hover,
chooser_widget_t > quick_filter_widget_t:hover {
    border-color: #46566A;
}
TChooser > quick_filter_widget_t[modernUiQuickFilterFocusWithin="true"],
chooser_widget_t > quick_filter_widget_t[modernUiQuickFilterFocusWithin="true"] {
    background: #101722;
    border-color: #52677F;
}
TChooser > quick_filter_widget_t > QPushButton,
chooser_widget_t > quick_filter_widget_t > QPushButton {
    background: transparent;
    border: 0;
    border-radius: @CONTROL_RADIUS@;
    margin: 5px 1px;
    /* Replace IDA's saturated clear glyph while retaining its DPI-aware hit
       target.  The small inset hover surface reads as an icon button rather
       than a second half-pill inside the search card. */
    padding: 0;
}
TChooser > quick_filter_widget_t > QPushButton:hover,
chooser_widget_t > quick_filter_widget_t > QPushButton:hover {
    background: #2A3543;
}
TChooser > quick_filter_widget_t > QPushButton:pressed,
chooser_widget_t > quick_filter_widget_t > QPushButton:pressed {
    background: #344256;
}
TChooser > quick_filter_widget_t > QPushButton:focus,
chooser_widget_t > quick_filter_widget_t > QPushButton:focus {
    background: #293546;
    border: 1px solid #52677F;
}
TChooser > quick_filter_widget_t > QPushButton:disabled,
chooser_widget_t > quick_filter_widget_t > QPushButton:disabled {
    background: transparent;
    border: 0;
}
TChooser > quick_filter_widget_t > quick_filter_input_t,
chooser_widget_t > quick_filter_widget_t > quick_filter_input_t,
TChooser > quick_filter_widget_t > quick_filter_input_t:focus,
chooser_widget_t > quick_filter_widget_t > quick_filter_input_t:focus {
    background: transparent;
    border: 0;
    border-radius: 0;
    margin: 0;
    /* IDA already reserves 7 logical px through QLineEdit::textMargins().
       Remove only the generic QLineEdit's additional left padding.  Retain
       the density-aware vertical inset so the rounded search card keeps its
       intended height, plus a quiet right inset for typed filter text. */
    padding: @CONTROL_V@ 8px @CONTROL_V@ 0;
}
TChooser > quick_filter_widget_t > quick_filter_input_t:disabled,
chooser_widget_t > quick_filter_widget_t > quick_filter_input_t:disabled {
    color: #687486;
    placeholder-text-color: #596575;
}
TChooser#Strings > QStatusBar,
chooser_widget_t#Strings > QStatusBar {
    background: transparent;
    color: #8794A6;
    border: 0;
    border-radius: 0;
    margin: 0 10px 4px 10px;
    min-height: 24px;
    padding: 0 8px;
}
TChooser#Strings > QStatusBar::item,
chooser_widget_t#Strings > QStatusBar::item {
    border: 0;
}
TChooser#Strings > QStatusBar > QLabel,
chooser_widget_t#Strings > QStatusBar > QLabel {
    background: transparent;
    padding-left: 8px;
}

/* Known built-in project-tree hosts use the same single-outline card and
   muted footer as Strings.  The private IDA class boundary deliberately keeps
   these rules away from plugin QTreeViews and custom-painted viewers. */
standalone_dirtree_widget_host_t {
    background: #14161C;
    border: 0;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t {
    background: #0F141B;
    color: #D7DEE8;
    border: 1px solid #354253;
    border-radius: @PANEL_RADIUS@;
    margin: 7px 10px 4px 10px;
    padding: 3px;
    outline: 0;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t:focus {
    border-color: #50627A;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QWidget#qt_scrollarea_viewport {
    background: #0F141B;
    border: 0;
    border-radius: @PANEL_INNER_RADIUS@;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QHeaderView {
    background: transparent;
    border: 0;
    border-top-left-radius: @PANEL_INNER_RADIUS@;
    border-top-right-radius: @PANEL_INNER_RADIUS@;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QHeaderView::section {
    background: #1B232D;
    color: #C1CBD8;
    border: 0;
    border-right: 1px solid #293441;
    border-bottom: 1px solid #303B49;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QHeaderView::section:first {
    border-top-left-radius: @PANEL_INNER_RADIUS@;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QHeaderView::section:last {
    border-top-right-radius: @PANEL_INNER_RADIUS@;
}
standalone_dirtree_widget_host_t > standalone_dirtree_widget_t > QHeaderView::section:last {
    border-right: 0;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t {
    background: #111822;
    border: 1px solid #354253;
    border-radius: @RADIUS@;
    margin: 0 10px 3px 10px;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t:hover {
    border-color: #46566A;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t[modernUiQuickFilterFocusWithin="true"] {
    background: #101722;
    border-color: #52677F;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > QPushButton {
    background: transparent;
    border: 0;
    border-radius: @CONTROL_RADIUS@;
    margin: 5px 1px;
    /* Preserve the host's DPI-aware width; fixed button geometry can jitter
       when a dock crosses monitors with different scale factors. */
    padding: 0;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > QPushButton:hover {
    background: #2A3543;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > QPushButton:pressed {
    background: #344256;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > QPushButton:focus {
    background: #293546;
    border: 1px solid #52677F;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > QPushButton:disabled {
    background: transparent;
    border: 0;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > quick_filter_input_t,
standalone_dirtree_widget_host_t > quick_filter_widget_t > quick_filter_input_t:focus {
    background: transparent;
    border: 0;
    border-radius: 0;
    margin: 0;
    /* Match the built-in Strings filter: native textMargins provide the left
       safety inset, so do not stack the global QLineEdit padding on top. */
    padding: @CONTROL_V@ 8px @CONTROL_V@ 0;
}
standalone_dirtree_widget_host_t > quick_filter_widget_t > quick_filter_input_t:disabled {
    color: #687486;
    placeholder-text-color: #596575;
}
standalone_dirtree_widget_host_t > QStatusBar {
    background: transparent;
    color: #8794A6;
    border: 0;
    border-radius: 0;
    margin: 0 10px 4px 10px;
    min-height: 24px;
    padding: 0 8px;
}
standalone_dirtree_widget_host_t > QStatusBar::item {
    border: 0;
}
standalone_dirtree_widget_host_t > QStatusBar > QLabel {
    background: transparent;
    padding-left: 8px;
}

/* Keep native scrollbar hit targets intact while reducing the visual weight
   of the thumbs inside built-in chooser cards. */
