viewer_t, viewer_t[os-dark-theme="true"] {
    qproperty-viewer-bg: #111318;
    qproperty-node-bg-import: #553C58;
    qproperty-node-bg-code: #253A59;
    qproperty-node-bg-data: #294A3A;
    qproperty-node-bg-default: #303641;
    qproperty-node-border: #758195;
    qproperty-node-text: #E2E8F0;
    qproperty-edge-default: #697386;
    qproperty-edge-highlighted: #82AAFF;
}
viewer_t QWidget, viewer_t[os-dark-theme="true"] QWidget {
    background: #111318;
    color: #D8DEE9;
}
CustomIDAMemo, CustomIDAMemo[os-dark-theme="true"] {
    border: 0;
    qproperty-line-bg-default: #111318;
    qproperty-line-bg-selected: #34415B;
    /* IDA's native primary identifier highlight is saturated yellow.  Keep
       the match cue distinct from row selection while staying in the
       theme's restrained blue-gray range. */
    qproperty-line-bg-highlight: #40516B;
    qproperty-line-fg-default: #C8D0DC;
    qproperty-line-fg-regular-comment: #7A8495;
    qproperty-line-fg-repeatable-comment: #8892A3;
    qproperty-line-fg-automatic-comment: #626C7C;
    qproperty-line-fg-insn: #D7DEE8;
    qproperty-line-fg-dummy-data-name: #9FB5D1;
    qproperty-line-fg-regular-data-name: #A9C1DE;
    qproperty-line-fg-demangled-name: #82AAFF;
    qproperty-line-fg-punctuation: #AAB4C3;
    qproperty-line-fg-charlit-in-insn: #C3E88D;
    qproperty-line-fg-strlit-in-insn: #C3E88D;
    qproperty-line-fg-numlit-in-insn: #F78C6C;
    qproperty-line-fg-void-opnd: #FF6B7A;
    qproperty-line-fg-code-xref: #89DDFF;
    qproperty-line-fg-data-xref: #7FDBCA;
    qproperty-line-fg-code-xref-to-tail: #F78C6C;
    qproperty-line-fg-data-xref-to-tail: #D5C07B;
    qproperty-line-fg-error: #FF5370;
    qproperty-line-fg-line-prefix: #697386;
    qproperty-line-fg-opcode-byte: #596273;
    qproperty-line-fg-extra-line: #C792EA;
    qproperty-line-fg-alt-opnd: #D4A8FF;
    qproperty-line-fg-hidden: #FFCB6B;
    qproperty-line-fg-libfunc: #89DDFF;
    qproperty-line-fg-locvar: #F78C6C;
    qproperty-line-fg-dummy-code-name: #FFCB6B;
    qproperty-line-fg-asm-directive: #C3E88D;
    qproperty-line-fg-macro: #C792EA;
    qproperty-line-fg-strlit-in-data: #C3E88D;
    qproperty-line-fg-charlit-in-data: #C3E88D;
    qproperty-line-fg-numlit-in-data: #F78C6C;
    qproperty-line-fg-keyword: #C792EA;
    qproperty-line-fg-register-name: #89DDFF;
    qproperty-line-fg-import-name: #D4A8FF;
    qproperty-line-fg-segment-name: #FFCB6B;
    qproperty-line-fg-dummy-unknown-name: #B2CCD6;
    qproperty-line-fg-code-name: #82AAFF;
    qproperty-line-fg-unknown-name: #D4A8FF;
    qproperty-line-fg-collapsed-line: #FFCB6B;
    qproperty-caret: #F1F5FA;
    qproperty-line-pfx-libfunc: #89DDFF;
    qproperty-line-pfx-func: #697386;
    qproperty-line-pfx-insn: #D05268;
    qproperty-line-pfx-data: #7FDBCA;
    qproperty-line-pfx-unexplored: #B5A45D;
    qproperty-line-pfx-extern: #C792EA;
    qproperty-line-pfx-current-line: #FFCB6B;
    qproperty-line-pfx-current-item: #F78C6C;
    qproperty-line-pfx-lumina: #73D18B;
    qproperty-graph-bg-top: #141820;
    qproperty-graph-bg-bottom: #0F1218;
    qproperty-graph-node-title-normal: #252B35;
    qproperty-graph-node-title-selected: #34415B;
    qproperty-graph-node-title-current: #2D3A4D;
    qproperty-graph-node-shadow: #0B0D12;
    qproperty-graph-edge-normal: #697386;
    qproperty-graph-edge-yes: #73D18B;
    qproperty-graph-edge-no: #FF6B7A;
    qproperty-graph-edge-high: #82AAFF;
    qproperty-graph-edge-selected: #FFCB6B;
    qproperty-graph-node-frame-selected: #82AAFF;
}
GraphMiniView, GraphMiniView[os-dark-theme="true"] {
    background: #111319;
    border: 1px solid #292E38;
    qproperty-fog: rgba(9, 12, 17, 0.42);
    qproperty-crosshairs: @ACCENT@;
}
navband_t, navband_t[os-dark-theme="true"] {
    background: #111319;
    /* The native painter fills a square rail.  navband_runtime clips the
       coloured segments after native paint; these values keep the fallback
       stylesheet path visually consistent when the overlay is unavailable. */
    border: 1px solid #303946;
    border-radius: @SMALL_RADIUS@;
    qproperty-lib-function: #50A9A8;
    qproperty-function: #347FB1;
    qproperty-code: #9D6858;
    qproperty-data: #818895;
    qproperty-undefined: #777651;
    qproperty-extern: #9D619E;
    qproperty-lumina-function: #469958;
    qproperty-hl-lib-function: #6FC3C1;
    qproperty-hl-function: #559AC7;
    qproperty-hl-code: #BC7B67;
    qproperty-hl-data: #A2A9B4;
    qproperty-hl-undefined: #9A9868;
    qproperty-hl-extern: #BD7DBE;
    qproperty-hl-lumina-function: #65B975;
    qproperty-hl-outline: @ACCENT@;
    qproperty-error: #C9566A;
    qproperty-gap: #303641;
    qproperty-cursor: #A8C7FA;
    qproperty-auto-analysis-cursor: #D8A657;
}
/* Only the fixed 15x15 colour chips in navigator_t's legend are rounded.
   navband_runtime also masks their native square paint; adjacent text labels
   stay square so their baselines and spacing do not shift on rebuild. */
ui_label_t[modernUiNavLegendSwatch="true"] {
    border: 0;
    border-radius: 4px;
}
TCpuRegs { background: #14161c; }
TCpuRegs ui_label_t { border-radius: 3px; padding: 2px 4px; }
